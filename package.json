{
  "name": "agent-diff-cursor",
  "version": "0.1.0",
  "description": "Show edits made by any coding agent as Cursor's inline Keep/Undo diffs.",
  "keywords": [
    "cursor",
    "diff",
    "agent",
    "claude-code",
    "opencode",
    "hooks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyianx/agent-diff-cursor.git"
  },
  "homepage": "https://github.com/dyianx/agent-diff-cursor#readme",
  "bugs": {
    "url": "https://github.com/dyianx/agent-diff-cursor/issues"
  },
  "bin": {
    "agent-diff": "bin/agent-diff.js"
  },
  "files": [
    "bin",
    "dist",
    "examples"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build:cli": "esbuild src/cli/main.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/cli.js",
    "build:extension": "esbuild src/extension/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=extension/dist/extension.js",
    "package:extension": "cd extension && vsce package --no-dependencies --allow-missing-repository --skip-license --out ../dist/agent-diff.vsix",
    "build": "npm run check && npm run build:cli && npm run build:extension && npm run package:extension",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "3.3.2",
    "esbuild": "0.25.0",
    "typescript": "5.8.3"
  }
}
